#:schema https://docs.jj-vcs.dev/latest/config-schema.json

[user]
name = "Matan Lurey"
email = "{{ .email }}"

[ui]
pager = "delta"
diff-formatter = ":git"

[aliases]
push = ["util", "exec", "--", "jj-hp", "push"]
fresh = ["util", "exec", "--", "bash", "-c", "set -euo pipefail\njj git fetch\njj new main@origin", ""]

[merge-tools.delta]
program = "delta"
diff-args = ["--color-only"]
